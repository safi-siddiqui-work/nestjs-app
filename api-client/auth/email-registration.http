@baseUrl={{$dotenv baseUrl}}
@email={{$dotenv email}}
@password={{$dotenv password}}
@username={{$dotenv username}}
@bearerToken={{$dotenv bearerToken}}

### request-otp
POST {{baseUrl}}/auth/email-registration/request-otp
content-type: application/json

{
    "email": "{{email}}"
}

### verify-otp
POST {{baseUrl}}/auth/email-registration/verify-otp
content-type: application/json
Authorization: Bearer {{bearerToken}}

{
    "code": "555555"
}

### create-user
POST {{baseUrl}}/auth/email-registration/create-user
content-type: application/json
Authorization: Bearer {{bearerToken}}

{
    "name": "Safi Siddiqui",
    "username": "{{username}}",
    "password": "{{password}}"
}