@baseUrl={{$dotenv baseUrl}}
@email={{$dotenv email}}
@password={{$dotenv password}}
@username={{$dotenv username}}
@bearerToken={{$dotenv bearerToken}}

### email-registration/request-otp
POST {{baseUrl}}/auth/email-registration/request-otp
content-type: application/json

{
    "email": "{{email}}"
}

### email-registration/verify-otp
POST {{baseUrl}}/auth/email-registration/verify-otp
content-type: application/json
Authorization: Bearer {{bearerToken}}

{
    "code": "35219444"
}

### email-registration/create-user
POST {{baseUrl}}/auth/email-registration/create-user
content-type: application/json
Authorization: Bearer {{bearerToken}}

{
    "name": "Safi Siddiqui",
    "username": "{{username}}",
    "password": "{{password}}"
}

### current-user/me
POST {{baseUrl}}/auth/current-user/me
content-type: application/json
Authorization: Bearer {{bearerToken}}

### email-password-login
POST {{baseUrl}}/auth/email-password-login
content-type: application/json

{
    "email": "{{email}}",
    "password": "{{password}}"
}
